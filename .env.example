# .env.sample
# Configuration Template for FSDS Containerized Platform under Rootless Podman
# Copy this file to '.env' and modify the values as needed.
#
# Usage:
#   cp .env.sample .env

# ==============================================================================
# 🗄️ Database Configurations
# ==============================================================================
POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_DB='postgres' 
POSTGRES_PORT='5432'

# ==============================================================================
# 🌪️ Airflow & DataHub Configurations
# ==============================================================================
AIRFLOW_UID='50000'
AIRFLOW_DB_NAME='airflow'
AIRFLOW_DB_USER='airflow'
AIRFLOW_DB_PASSWORD='airflow'
AIRFLOW_FERNET_KEY=''
AIRFLOW_WEBSERVER_PORT='8082'

DATAHUB_DB_NAME='datahub'
DATAHUB_DB_USER='datahub'
DATAHUB_DB_PASSWORD='datahub_password'
DATAHUB_GMS_PORT='8088'
DATAHUB_GMS_URL='http://127.0.0.1:8088'
DATAHUB_FRONTEND_PORT='9002'

# ==============================================================================
# 🔌 Network Port Mappings
# ==============================================================================
KAFKA_PORT='9092'
KAFKA_CONTROLLER_PORT='9093'
DEBEZIUM_PORT='8083'
SCHEMA_REGISTRY_PORT='8081'
REDPANDA_CONSOLE_PORT='8086'
PGWEB_PORT='8085'
REDIS_PORT='6379'
FLINK_REST_PORT='8087'
FLINK_JM_PORT='6123'
OPENSEARCH_PORT='9200'

# ==============================================================================
# 📦 Podman Rootless Storage & Cache Redirects
# ==============================================================================
# Dynamic paths relative to the project workspace root
XDG_DATA_HOME="${PROJECT_ROOT}/../.tmp/data"
XDG_CONFIG_HOME="${PROJECT_ROOT}/../.tmp/config"
XDG_CACHE_HOME="${PROJECT_ROOT}/../.tmp/cache"

# Current Host User & Group ID mapping for rootless OCI namespaces
# These are evaluated dynamically at runtime by the script.
CURRENT_UID="$(id -u)"
CURRENT_GID="$(id -g)"

# Suppress Podman cgroups-v1 deprecation warnings in terminal outputs
PODMAN_IGNORE_CGROUPSV1_WARNING='1'

