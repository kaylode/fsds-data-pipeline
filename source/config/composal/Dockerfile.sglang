# config/Dockerfile.sglang
# Custom Dockerfile for SGLang with resolved dependencies for Gemma 3
FROM nvidia/cuda:12.6.0-cudnn-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install git, libnuma-dev, and libibverbs-dev (required by sgl-kernel/mscclpp dependencies to compile from source)
RUN apt-get -o APT::Sandbox::User=root update && apt-get -o APT::Sandbox::User=root install -y --no-install-recommends git libnuma-dev libibverbs-dev && rm -rf /var/lib/apt/lists/*

# Install uv for extremely fast and robust dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set working directory
WORKDIR /sgl-workspace

# Install a managed Python 3.12 using uv
RUN uv python install 3.12

# Create a virtual environment using uv's python and activate it by updating PATH
RUN uv venv /opt/venv --python 3.12
ENV PATH="/opt/venv/bin:$PATH"

# Install cmake via pip/uv first so that SGLang can build its custom CUDA kernels (sgl-kernel)
# without needing apt-get, which avoids permission-denied issues on unmapped directories.
RUN uv pip install --no-cache cmake
ENV CMAKE_ARGS="-DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DSGL_KERNEL_COMPILE_THREADS=4"
ENV CMAKE_BUILD_PARALLEL_LEVEL=4

# Install Rust toolchain (needed for SGLang's gRPC Rust extension module)
# We use python to download the rustup-init binary directly, bypassing the shell script's requirement for curl/wget.
RUN python3 -c "import urllib.request; urllib.request.urlretrieve('https://static.rust-lang.org/rustup/dist/x86_64-unknown-linux-gnu/rustup-init', '/tmp/rustup-init')" && \
    chmod +x /tmp/rustup-init && \
    /tmp/rustup-init -y && \
    rm /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"

# Install protoc (needed by prost-build to compile SGLang's gRPC Rust extension)
# We use Python to download and extract the official precompiled protoc zip to /usr/local,
# adding a User-Agent header to prevent GitHub from blocking the download.
RUN python3 -c "import urllib.request, zipfile, io; \
    req = urllib.request.Request('https://github.com/protocolbuffers/protobuf/releases/download/v29.1/protoc-29.1-linux-x86_64.zip', headers={'User-Agent': 'Mozilla/5.0'}); \
    data = urllib.request.urlopen(req).read(); \
    zipfile.ZipFile(io.BytesIO(data)).extractall('/usr/local')" && \
    chmod +x /usr/local/bin/protoc

# Pre-install sgl-deep-gemm using its official CUDA 12 wheel.
RUN uv pip install --no-cache \
    https://github.com/sgl-project/whl/releases/download/v0.1.0/sgl_deep_gemm-0.1.0+cu129-py3-none-manylinux2014_x86_64.whl

# Copy SGLang source repository pre-cloned on the host into the container.
COPY sglang-src /sgl-workspace

# Build and install sgl-kernel from source.
# This compiles custom CUDA kernels directly targeting the container's CUDA 12.6 toolkit
# and links against libnvrtc.so.12, resolving the library loading issue.
RUN uv pip install --no-cache /sgl-workspace/sgl-kernel

# Install SGLang along with all its features using uv pip inside our venv
RUN uv pip install --no-cache -e "python[all]" --extra-index-url https://download.pytorch.org/whl/cu126 --index-strategy unsafe-best-match

# Explicitly upgrade transformers, vllm, mamba-ssm, and causal-conv1d
# uv will automatically resolve all package conflicts during this step
RUN uv pip install --no-cache -U \
    transformers \
    vllm \
    mamba-ssm \
    causal-conv1d \
    --extra-index-url https://download.pytorch.org/whl/cu126 \
    --index-strategy unsafe-best-match

# Set up runtime configuration
EXPOSE 30000

# We keep bash entrypoint support for the custom host CUDA library linking (ldconfig) in compose
CMD ["python3", "-m", "sglang.launch_server"]
