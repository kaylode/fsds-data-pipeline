
# Databases

POSTGRES_USER='postgres'
POSTGRES_PASSWORD='postgres'
POSTGRES_DB='postgres' 
POSTGRES_PORT='5432'

# Airflow & DataHub Configurations
AIRFLOW_UID='50000'
AIRFLOW_DB_NAME='airflow'
AIRFLOW_DB_USER='airflow'
AIRFLOW_DB_PASSWORD='airflow'
AIRFLOW_FERNET_KEY=''
AIRFLOW_WEBSERVER_PORT='8082'

DATAHUB_DB_NAME='datahub'
DATAHUB_DB_USER='datahub'
DATAHUB_DB_PASSWORD='datahub_password'
DATAHUB_GMS_PORT='8088'
DATAHUB_GMS_URL='http://127.0.0.1:8088'

# Ports
KAFKA_PORT='9092'
KAFKA_CONTROLLER_PORT='9093'
FLINK_REST_PORT='8095'
FLINK_JM_PORT='6123'
DEBEZIUM_PORT='8083'
SCHEMA_REGISTRY_PORT='8081'
REDPANDA_CONSOLE_PORT='8086'
PGWEB_PORT='8085'
REDIS_PORT='6379'
OPENSEARCH_PORT='9200'

# Flink Windowing & Watermarking
WINDOW_SIZE_MINS='5'
WINDOW_SLIDE_SECS='10'
WATERMARK_LAG_SECS='5'

# Storage Stack Ports
MINIO_PORT='9000'
MINIO_CONSOLE_PORT='9001'
METASTORE_DB_PORT='5433'
HIVE_METASTORE_PORT='9083'
TRINO_HOST='localhost'
TRINO_PORT='8090'
TRINO_USER='trino'
METASTORE_DB_NAME='metastore'
METASTORE_DB_USER='hive'
METASTORE_DB_PASSWORD='hive'
MINIO_ROOT_USER='minioadmin'
MINIO_ROOT_PASSWORD='minioadmin'


# Podman Storage & Cache Redirects (Rootless)
XDG_DATA_HOME="${PROJECT_ROOT}/../.tmp/data"
XDG_CONFIG_HOME="${PROJECT_ROOT}/../.tmp/config"
XDG_CACHE_HOME="${PROJECT_ROOT}/../.tmp/cache"

# Current Host User ID and Group ID for Rootless OCI Mapping
CURRENT_UID="$(id -u)"
CURRENT_GID="$(id -g)"

# Suppress Podman cgroups-v1 deprecation warnings
PODMAN_IGNORE_CGROUPSV1_WARNING='1'

# Spark Standalone Cluster
SPARK_MASTER_PORT='7077'
SPARK_WEBUI_PORT='8089'
SPARK_WORKER_WEBUI_PORT='8091'
SPARK_WORKER_MEMORY='8g'
SPARK_WORKER_CORES='6'

